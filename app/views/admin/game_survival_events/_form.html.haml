= render 'shared/error_messages', object: form.object

.fields-group
  = form.input :title, label: '이벤트 제목', wrapper: :with_block_label
  = form.input :description, label: '상황 설명', wrapper: :with_block_label
  = form.input :background_image, as: :file, label: 'RP 배경 이미지', hint: 'JPG, PNG, WebP · 최대 8MB · 권장 비율 2:1', input_html: { accept: GameSurvivalEvent::BACKGROUND_IMAGE_MIME_TYPES.join(',') }, wrapper: :with_block_label
  - if form.object.background_image.exists?
    = form.input :remove_background_image, as: :boolean, label: '현재 배경 이미지 삭제', wrapper: :with_label
  - messages = Array(form.object.failure_messages).first(8)
  - messages += Array.new(8 - messages.size, '')
  - messages.each_with_index do |message, index|
    .input.with_block_label
      = label_tag "game_survival_event_failure_messages_#{index}", "탈락 문구 #{index + 1}#{index == 7 ? ' (선택)' : ''}"
      = text_field_tag 'game_survival_event[failure_messages][]', message, id: "game_survival_event_failure_messages_#{index}", required: index < 7
  = form.input :reward_item_ids,
               as: :check_boxes,
               collection: game_items.map { |item| [item.name, item.id] },
               collection_wrapper_tag: 'ul',
               item_wrapper_tag: 'li',
               include_blank: false,
               label: '무작위 보상 아이템',
               hint: '7개 또는 8개를 체크하세요. 최종 클리어 시 이 목록에서 하나를 무작위로 지급합니다.',
               wrapper: :with_block_label
  = form.input :starts_at, as: :datetime, label: '시작 시각', include_blank: true, wrapper: :with_block_label
  = form.input :ends_at, as: :datetime, label: '종료 시각', include_blank: true, wrapper: :with_block_label
  = form.input :active, as: :boolean, label: '활성화', wrapper: :with_label
