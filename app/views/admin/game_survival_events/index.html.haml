- content_for :page_title do
  생존 이벤트
- content_for :heading_actions do
  = link_to '새 이벤트', new_admin_game_survival_event_path, class: 'button'

%table.table
  %thead
    %tr
      %th 제목
      %th 참여
      %th 생존
      %th 단계
      %th 기간
      %th 상태
      %th
  %tbody
    - @events.each do |event|
      %tr
        %td= event.title
        %td= event.entries.length
        %td= event.entries.count(&:survived?)
        %td= event.steps.length
        %td= [event.starts_at&.to_fs(:short), event.ends_at&.to_fs(:short)].compact.join(' ~ ').presence || '상시'
        %td
          - if event.available?
            진행 중
          - elsif event.active?
            대기/종료
          - else
            비활성
        %td
          = table_link_to 'list', '단계 관리', admin_game_survival_event_steps_path(event)
          = table_link_to 'edit', '수정', edit_admin_game_survival_event_path(event)
          - if event.entries.any?
            = table_link_to 'history', '참여 초기화', reset_entries_admin_game_survival_event_path(event), method: :post, data: { confirm: '모든 참여자의 진행·결과 기록을 초기화하시겠습니까? 이미 지급된 아이템은 회수되지 않습니다.' }
          - if event.active?
            = table_link_to 'block', '비활성화', admin_game_survival_event_path(event), method: :delete, data: { confirm: '비활성화하시겠습니까?' }
= paginate @events
