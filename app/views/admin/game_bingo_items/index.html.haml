- content_for :page_title do
  #{@event.title} · 빙고 항목
- content_for :heading_actions do
  = link_to '이벤트 목록', admin_game_bingo_events_path, class: 'button button-tertiary'
  = link_to '새 항목', new_admin_game_bingo_event_item_path(@event), class: 'button'

- if @event.items.active.count < 9
  .flash-message.alert 상점에 노출하려면 활성 항목을 9개 이상 등록해야 합니다.
%table.table
  %thead
    %tr
      %th 항목
      %th 설명
      %th 칸 보상
      %th 상태
      %th
  %tbody
    - @items.each do |item|
      %tr
        %td= item.title
        %td= item.description
        %td= item.reward_summary
        %td= item.active? ? '활성' : '비활성'
        %td
          = table_link_to 'edit', '수정', edit_admin_game_bingo_event_item_path(@event, item)
          - if item.active?
            = table_link_to 'block', '비활성화', admin_game_bingo_event_item_path(@event, item), method: :delete
