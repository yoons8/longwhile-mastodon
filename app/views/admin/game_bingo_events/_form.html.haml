= render 'shared/error_messages', object: form.object
.fields-group
  = form.input :title, label: '이벤트 제목', wrapper: :with_block_label
  = form.input :description, label: '이벤트 설명', wrapper: :with_block_label
  = form.input :starts_at, as: :datetime, label: '시작 시각', include_blank: true, wrapper: :with_block_label
  = form.input :ends_at, as: :datetime, label: '종료 시각', include_blank: true, wrapper: :with_block_label
  = form.input :active, as: :boolean, label: '활성화', wrapper: :with_label
